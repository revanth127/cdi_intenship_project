# ------------------------------------------------------------------------------
# Environment Variables Configuration
# Copy this file to .env and adjust values for your environment.
# ------------------------------------------------------------------------------

# Application
PROJECT_NAME="Order-to-Audit Backend"
ENVIRONMENT="development"
DEBUG=true

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=order_to_audit
POSTGRES_PORT=5434

# SQLAlchemy Database URL
# For host/local development (connecting to postgres on localhost):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/order_to_audit

# For Docker compose networking (inside container):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/order_to_audit

# JWT Security
# Must be stable across restarts (loaded from environment, NEVER randomly generated per process start).
# If generated dynamically on start, uvicorn --reload will invalidate all active sessions on each file save.
# Generate once in production: openssl rand -hex 32
SECRET_KEY=order-to-audit-stable-production-secret-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list format or comma-separated strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Set true to show seed-configured demo logins in the frontend.
VITE_DEMO_MODE=false
